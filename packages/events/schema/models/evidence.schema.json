{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "description": "A first-class, citable record produced by the engine. Verdicts may cite only these.",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "type",
    "targets",
    "summary",
    "data",
    "artifacts",
    "stability",
    "origin",
    "produced_by",
    "seq"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/EvidenceId"
    },
    "run_id": {
      "$ref": "../common.schema.json#/$defs/RunId"
    },
    "type": {
      "$ref": "../common.schema.json#/$defs/EvidenceType"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/$defs/Target"
      }
    },
    "summary": {
      "$ref": "../common.schema.json#/$defs/ShortText"
    },
    "data": {
      "description": "Type-specific structured data.",
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "artifact.schema.json"
      }
    },
    "stability": {
      "$ref": "../common.schema.json#/$defs/Stability"
    },
    "origin": {
      "$ref": "../common.schema.json#/$defs/Origin"
    },
    "produced_by": {
      "type": "object",
      "required": ["component", "version"],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "seq": {
      "description": "seq of the evidence.created event that introduced this item.",
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
