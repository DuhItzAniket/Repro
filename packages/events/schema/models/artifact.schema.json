{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactRef",
  "description": "Pointer to a raw, content-addressed artifact.",
  "type": "object",
  "required": ["path", "sha256", "media_type", "size_bytes"],
  "properties": {
    "path": {
      "description": "Path relative to the run's artifact directory.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sha256": {
      "$ref": "../common.schema.json#/$defs/Sha256"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
