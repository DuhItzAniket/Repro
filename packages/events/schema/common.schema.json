{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repro common definitions",
  "description": "Shared identifiers, enumerations and value objects used by the envelope, payloads and models.",
  "$defs": {
    "EventId": {
      "description": "Event identifier: 'evt_' + ULID.",
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "description": "Run identifier: 'run_' + ULID.",
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "EvidenceId": {
      "description": "Evidence identifier: 'ev_' + ULID. Verdicts cite these.",
      "type": "string",
      "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ClaimId": {
      "description": "Claim identifier within a run: C1, C2, ...",
      "type": "string",
      "pattern": "^C[1-9][0-9]{0,3}$"
    },
    "AgentId": {
      "description": "Agent/worker identifier, e.g. 'a07'.",
      "type": "string",
      "pattern": "^a[0-9]{2,3}$"
    },
    "SymbolId": {
      "description": "Symbol identity stable across refs: '<module>:<qualname>#<ordinal>'. Module-level code uses the qualname '<module>'.",
      "type": "string",
      "pattern": "^[^\\s:]+:[^\\s#]+#[0-9]+$",
      "maxLength": 1024
    },
    "TestId": {
      "description": "pytest node id, repository-relative with forward slashes.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "RelPath": {
      "description": "Repository-relative POSIX path: no drive letter, no leading slash, no backslashes, no '..' segments.",
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$",
      "maxLength": 1024
    },
    "GitSha": {
      "description": "Full git object id (SHA-1 or SHA-256).",
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "Sha256": {
      "description": "Lowercase hex SHA-256 digest.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Timestamp": {
      "description": "RFC 3339 UTC timestamp with 'Z' suffix.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "DurationMs": {
      "description": "Duration in milliseconds.",
      "type": "number",
      "minimum": 0
    },
    "Stage": {
      "description": "Pipeline stage (drives the UI progress bar).",
      "enum": ["read", "build", "run", "diff", "check", "review", "card"]
    },
    "Status": {
      "description": "Event status.",
      "enum": ["start", "progress", "ok", "warn", "fail"]
    },
    "Side": {
      "description": "Execution side: base (A), a second base run with a different seed and test order (A′) used to measure noise, or head (H).",
      "enum": ["base", "base_repeat", "head"]
    },
    "SnapshotSide": {
      "description": "Which ref a snapshot or environment belongs to.",
      "enum": ["base", "head"]
    },
    "Target": {
      "description": "What an event or evidence item is about. At least one field is present.",
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/RelPath"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolId"
        },
        "test": {
          "$ref": "#/$defs/TestId"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "GitRef": {
      "type": "object",
      "required": ["ref", "sha"],
      "properties": {
        "ref": {
          "description": "Ref name as given by the user (branch, tag or sha).",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha": {
          "$ref": "#/$defs/GitSha"
        }
      },
      "additionalProperties": false
    },
    "TestOutcome": {
      "enum": ["passed", "failed", "error", "skipped", "xfailed", "xpassed"]
    },
    "OutcomeClass": {
      "description": "Base→head outcome class. 'modified' means the test code differs between sides; 'flaky' means A and A′ (or reruns) disagree.",
      "enum": ["F2P", "P2P", "P2F", "F2F", "new", "removed", "modified", "flaky"]
    },
    "ClaimKind": {
      "enum": ["fix", "feature", "refactor", "no-change", "perf", "deps", "test", "docs"]
    },
    "VerdictValue": {
      "enum": ["supported", "contradicted", "unverifiable"]
    },
    "CardStatus": {
      "enum": ["VERIFIED", "FLAGGED", "UNVERIFIABLE"]
    },
    "EvidenceType": {
      "enum": [
        "test_outcome",
        "test_change",
        "behaviour_diff",
        "probe_diff",
        "api_diff",
        "dep_diff",
        "lock_drift",
        "perf_diff",
        "invariant",
        "selection",
        "network_attempt",
        "subprocess_attempt",
        "file_attempt",
        "environment",
        "static_change",
        "policy_change",
        "policy"
      ]
    },
    "MissingReason": {
      "enum": [
        "no_covering_test",
        "environment_failed",
        "collection_error",
        "timeout",
        "unstable_observation",
        "trace_unavailable",
        "trace_truncated",
        "subprocess_untraced",
        "encoding_failed",
        "network_not_enforced",
        "perf_not_assessable",
        "unsupported_project",
        "verdict_rejected",
        "claim_unverifiable"
      ]
    },
    "IsolationLevel": {
      "description": "Highest isolation layer actually achieved (ARCHITECTURE §8).",
      "enum": ["L0", "L1", "L2", "L3", "L4"]
    },
    "NetworkEnforcement": {
      "enum": ["enforced", "detected-only"]
    },
    "SandboxBackend": {
      "enum": ["process", "docker", "gvisor"]
    },
    "AgentRole": {
      "enum": ["read", "build", "review", "gap", "probe", "qa"]
    },
    "BehaviourChange": {
      "description": "How a function behaves differently for the same input. calls_changed: in the same test it was called with other arguments on one side (E04).",
      "enum": [
        "result_changed",
        "exception_changed",
        "exception_added",
        "exception_removed",
        "input_mutated",
        "order_only",
        "calls_changed"
      ]
    },
    "Origin": {
      "enum": ["introduced", "pre-existing", "n/a"]
    },
    "Stability": {
      "enum": ["stable", "unstable", "n/a"]
    },
    "Preview": {
      "description": "Size-capped, normalised preview of a value (never raw repr of user objects).",
      "type": "string",
      "maxLength": 512
    },
    "ShortText": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
