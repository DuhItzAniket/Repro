{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "env.provisioned payload",
  "description": "An environment for one side was provisioned.",
  "type": "object",
  "required": [
    "side",
    "project_kind",
    "python_version",
    "lock_sha256",
    "installed_packages",
    "cache_hit",
    "duration_ms"
  ],
  "properties": {
    "side": {
      "$ref": "../common.schema.json#/$defs/SnapshotSide"
    },
    "project_kind": {
      "enum": [
        "uv",
        "poetry",
        "pdm",
        "requirements",
        "setuptools",
        "unknown",
        "npm",
        "pnpm",
        "yarn"
      ]
    },
    "python_version": {
      "description": "The environment's interpreter; null for a JavaScript project.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^3\\.[0-9]+\\.[0-9]+"
        },
        {
          "type": "null"
        }
      ]
    },
    "lock_sha256": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "installed_packages": {
      "type": "integer",
      "minimum": 0
    },
    "cache_hit": {
      "type": "boolean"
    },
    "duration_ms": {
      "$ref": "../common.schema.json#/$defs/DurationMs"
    },
    "node_version": {
      "description": "A JavaScript project's Node.js (K08).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
    }
  },
  "additionalProperties": false
}
