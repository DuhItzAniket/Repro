{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diff.api payload",
  "description": "A public API breaking change.",
  "type": "object",
  "required": ["evidence_id", "symbol_id", "breakage", "explanation"],
  "properties": {
    "evidence_id": {
      "$ref": "../common.schema.json#/$defs/EvidenceId"
    },
    "symbol_id": {
      "$ref": "../common.schema.json#/$defs/SymbolId"
    },
    "breakage": {
      "enum": [
        "parameter_moved",
        "parameter_removed",
        "parameter_changed_kind",
        "parameter_changed_default",
        "parameter_changed_required",
        "parameter_added_required",
        "return_changed_type",
        "object_removed",
        "object_changed_kind",
        "attribute_changed_type",
        "attribute_changed_value",
        "class_removed_base"
      ]
    },
    "explanation": {
      "$ref": "../common.schema.json#/$defs/ShortText"
    }
  },
  "additionalProperties": false
}
