{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph.node payload",
  "description": "A node of the dependency graph.",
  "type": "object",
  "required": ["node"],
  "properties": {
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "file", "line"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "type": {
          "enum": ["module", "class", "function", "method", "test"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "file": {
          "$ref": "../common.schema.json#/$defs/RelPath"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
