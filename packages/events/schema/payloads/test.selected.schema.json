{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test.selected payload",
  "description": "A test was selected (envelope target.test names it).",
  "type": "object",
  "required": ["reasons", "symbols"],
  "properties": {
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["blast_radius", "module_import", "new_test", "modified_test"]
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/SymbolId"
      }
    }
  },
  "additionalProperties": false
}
