{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cost.estimate payload",
  "description": "Client-side token and cost estimate for an agent call (not billing data).",
  "type": "object",
  "required": ["model", "input_tokens", "output_tokens", "cache_read_tokens", "usd", "estimate"],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cache_read_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "estimate": {
      "const": true
    },
    "source": {
      "description": "live: the call reached the model now; cassette: it was replayed, and this is what it cost when recorded (G02). Absent in logs from before G02.",
      "enum": ["live", "cassette"]
    }
  },
  "additionalProperties": false
}
