# Copy to `.env` for local development. `.env` is git-ignored; never commit real values.
# Repro reads these from the process environment. It does not auto-load .env files, so export
# them in your shell or use your editor's env-file support.

# Where Repro keeps its database, run artifacts and caches. Default: ~/.repro
REPRO_DATA_DIR=

# Log level for the engine: debug | info | warning | error. Default: info
REPRO_LOG_LEVEL=

# Needed only for agent features (Stage G). Without it, Repro runs in deterministic-only mode.
ANTHROPIC_API_KEY=
